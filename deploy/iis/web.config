<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse-proxy configuration for the simulation platform.

  IIS terminates TLS and forwards every request to the simserver process on
  loopback. The Go binary serves the API, the artifacts and the single-page
  app; IIS is only the public front door, so there is one place to bind the
  certificate and one process to keep running.

  Requires the URL Rewrite and Application Request Routing (ARR) modules, and
  ARR's proxy must be enabled at the server level. deploy/iis/setup-iis.ps1
  installs and configures both, including the two settings that cannot live in
  this file (server-level proxy enablement and the allowed X-Forwarded-Proto
  server variable).
-->
<configuration>
  <system.webServer>
    <!-- The run-progress stream is Server-Sent Events, a long-lived response.
         WebSockets are enabled too so the deployment is ready for them without
         another IIS change. -->
    <webSocket enabled="true" pingInterval="00:00:30" />

    <rewrite>
      <rules>
        <rule name="ReverseProxyToSimserver" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- The Go server reads this to know the original scheme was HTTPS,
                 so redirects and absolute links it builds stay on https. It is
                 trusted only because server.trust_proxy_headers is on and this
                 proxy is the only thing in front of it. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let the Go server's own error responses reach the client unchanged,
         rather than IIS replacing a JSON error with an HTML error page. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Model and animation uploads are large. Raise this to match
             storage.max_upload_bytes in the server config; the default here is
             1 GiB. IIS rejects anything larger before it reaches the server. -->
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>

    <!-- IIS should not compress or cache the proxied responses: the Go server
         already sets the caching it wants, and double-compression breaks the
         event stream. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
